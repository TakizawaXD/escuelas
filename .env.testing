# ==============================================================================
# CONFIGURACIÓN DEL PORTAL ESCOLAR ERP (PRUEBAS / TESTING)
# ==============================================================================

APP_NAME="Portal Escolar (TEST)"
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost:8080

# Usar una base de datos SQLite específica para pruebas
DB_PATH="database/escuela_erp_testing.sqlite"

# Clave secreta fija para testing
SECRET_KEY="test-environment-secret-key-32-chars-long"

# Configuración de correo falsa para pruebas locales (ej. Mailpit/Mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# ==============================================================================
# CONFIGURACIÓN DEL PORTAL ESCOLAR ERP (PRODUCCIÓN)
# ==============================================================================

APP_NAME="Portal Escolar"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://escuelas-erp.yourdomain.com

# Ruta de base de datos SQLite en producción (normalmente mapeada a un volumen persistente)
DB_PATH="database/escuela_erp.sqlite"

# Clave de seguridad (Generar una aleatoria única en producción)
SECRET_KEY="generame-con-un-token-criptografico-seguro-en-produccion"

# Configuración del servidor de correo de producción
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=tu-password-produccion-aqui
SMTP_SECURE=tls

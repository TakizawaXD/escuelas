# ==============================================================================
# CONFIGURACIÓN DEL PORTAL ESCOLAR ERP (PLANTILLA)
# ==============================================================================

APP_NAME="Portal Escolar"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Ruta a la base de datos SQLite (relativa al directorio raíz del proyecto)
DB_PATH="database/escuela_erp.sqlite"

# Clave secreta para firma de tokens y seguridad de sesión
SECRET_KEY="cambiame-por-una-clave-segura-de-32-caracteres"

# Configuración de Correo Electrónico (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=escuela@ejemplo.com
SMTP_PASS=tu-clave-secreta-aqui
SMTP_SECURE=tls

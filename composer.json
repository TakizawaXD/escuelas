{
  "name": "takizawaxd/escuelas-erp",
  "description": "Plataforma ERP Escolar Multi-Escuela con PHP y SQLite",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=7.4",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "friendsofphp/php-cs-fixer": "^3.50"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src_php/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}

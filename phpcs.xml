<?xml version="1.0"?>
<ruleset name="ERP Escolar Standard">
    <description>Coding standard for ERP Escolar based on PSR12.</description>
    
    <!-- Excluir directorios de dependencias y binarios -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/target/*</exclude-pattern>

    <!-- Usar estándar PSR12 -->
    <rule ref="PSR12"/>

    <!-- Archivos y carpetas a analizar -->
    <file>config</file>
    <file>auth</file>
    <file>modules</file>
    <file>src_php</file>
    <file>tests</file>
    <file>index.php</file>
</ruleset>
